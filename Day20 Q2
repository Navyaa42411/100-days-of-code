#include <stdio.h>

int main()
{
    long long n, place = 1;

    printf("Enter binary number: ");
    scanf("%lld", &n);

    while (place <= n)
        place *= 10;

    place /= 10;

    while (place > 0)
    {
        int digit = (n / place) % 10;

        if (digit == 0)
            printf("1");
        else
            printf("0");

        place /= 10;
    }

    return 0;
}
