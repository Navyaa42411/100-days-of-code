#include<stdio.h>
int main()
{
    int a,b;
    printf("Enter two numbers: \n");
    scanf("%d %d",&a,&b);
    printf("Sum of the two numbers is %d \n",a+b);
    printf("Difference of the two numbers is %d \n",a-b);
    printf("Product of the two numbers is %d \n",a*b);
    if (b == 0)
    {
        printf("Quotient is undefined because we cannot divide by zero.\n");
    }
    else
    {
        printf("Quotient of the two numbers is %d\n", a / b);
    }
    return 0;
}
