#include<stdio.h>
int main(){
 int a,i,prime=1;
 printf("Enter the number you want to check is prime or not:");
 scanf("%d",&a);
 if(a <= 1)
{
    prime = 0;
}
 for(i=2;i<a;i++){
  if(a%i==0){
    prime=0;
    break;
  }
 }
 if(prime==1){
  printf("%d is a prime number",a);
 }
 else{
  printf("%d is not a prime number",a);}
  return 0;
}
