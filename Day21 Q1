#include<stdio.h>
int main()
{
    int n, temp, first, last, place = 1, middle, result;
    printf("Enter a number: ");
    scanf("%d", &n);
    temp = n;
    last = n % 10;
    while (temp >= 10)
    {
        temp = temp / 10;
        place = place * 10;
    }
    first = temp;
    middle = (n % place) / 10;
    result = last * place + middle * 10 + first;
    printf("%d", result);
    return 0;
}
