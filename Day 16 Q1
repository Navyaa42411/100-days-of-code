#include <stdio.h>
int main()
{
    int n, remainder, stored = 0, place = 1;
    printf("Enter a number in decimal you want to convert in binary: ");
    scanf("%d", &n);
    while(n > 0)
    {
        remainder = n % 2;
        stored = stored + remainder * place;
        place = place * 10;
        n = n / 2;
    }
printf("Binary number is: %d", stored);
return 0;
}
