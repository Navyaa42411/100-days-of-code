#include <stdio.h>

int main()
{
    int cp, sp, percentage;

    printf("Enter cost price and selling price: ");
    scanf("%d %d", &cp, &sp);

    if (sp > cp)
    {
        percentage = ((sp - cp) * 100) / cp;
        printf("Profit %d%%", percentage);
    }
    else if (sp < cp)
    {
        percentage = ((cp - sp) * 100) / cp;
        printf("Loss %d%%", percentage);
    }
    else
    {
        printf("No Profit No Loss");
    }

    return 0;
}
